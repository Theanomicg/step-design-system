{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": [
    "tokens/**/*.ts",
    "tailwind/**/*.ts",
    "components/**/*.tsx",
    "icons/**/*.tsx",
    "utils/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "css",
    "fonts",
    "docs"
  ]
}
